APP_ENV={{ app_env }}
API_DOMAIN={{ api_domain }}
BACKEND_IMAGE={{ backend_image }}
POSTGRES_PASSWORD={{ postgres_password }}
GRAFANA_PASSWORD={{ grafana_password }}
DATABASE_URL=postgres://vpn:{{ postgres_password }}@postgres:5432/vpn?sslmode=disable
HTTP_ADDR=:8080
METRICS_ADDR=:9090
LOG_LEVEL=info
PANEL_MODE={{ panel_mode }}
REMNAWAVE_BASE_URL={{ 'http://panel-tunnel:3000' if panel_mode == 'remnawave' else '' }}
REMNAWAVE_API_TOKEN={{ remnawave_api_token }}
REMNAWAVE_SQUAD_UUID={{ remnawave_squad_uuid }}
NODE_HOST={{ node_host }}
TELEGRAM_MODE={{ telegram_mode }}
TELEGRAM_BOT_TOKEN={{ telegram_bot_token }}
TELEGRAM_BOT_USERNAME={{ telegram_bot_username }}
TELEGRAM_WEBHOOK_SECRET={{ telegram_webhook_secret }}
COMPOSE_PROFILES={{ ([] + (['polling'] if telegram_mode == 'polling' else []) + (['panel'] if panel_mode == 'remnawave' else [])) | join(',') }}
TOKEN_PEPPER={{ token_pepper }}
TRIAL_DAYS=30
AUTH_RATE_PER_MIN=10
HTTP_PORT={{ api_http_port }}
HTTPS_PORT={{ api_https_port }}
PUBLIC_API_URLS={{ api_public_url }}
