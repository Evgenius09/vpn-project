APP_ENV={{ app_env }}
API_DOMAIN={{ api_domain }}
BACKEND_IMAGE={{ backend_image }}
POSTGRES_PASSWORD={{ postgres_password }}
GRAFANA_PASSWORD={{ grafana_password }}
DATABASE_URL=postgres://vpn:{{ postgres_password }}@postgres:5432/vpn?sslmode=disable
