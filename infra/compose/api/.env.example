# Used by Compose and by the backend containers. Ansible renders the real file.
APP_ENV=staging
API_DOMAIN=localhost
POSTGRES_PASSWORD=change-me
GRAFANA_PASSWORD=change-me
DATABASE_URL=postgres://vpn:change-me@postgres:5432/vpn?sslmode=disable
HTTP_ADDR=:8080
METRICS_ADDR=:9090
LOG_LEVEL=info
PANEL_MODE=fake
TELEGRAM_MODE=fake
TOKEN_PEPPER=change-me-to-32-or-more-random-bytes
TRIAL_DAYS=3
AUTH_RATE_PER_MIN=10
PUBLIC_API_URLS=https://localhost
# A host where 443 is taken publishes HTTPS elsewhere (tech.md 36.1).
HTTP_PORT=80
HTTPS_PORT=443
# polling starts the bot service; it needs the two TELEGRAM_BOT_* values.
# webhook also needs the secret, which Ansible generates on the host.
COMPOSE_PROFILES=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
